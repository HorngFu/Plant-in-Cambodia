{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plant-in-cambodia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "plant-in-cambodia",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Branch builds run `wrangler preview`, which needs this block. Service bindings aren't copied
  // into previews; the prerendered site doesn't need WORKER_SELF_REFERENCE there.
  "previews": {},
}
